    "@cloudflare/workers-types": "^5.20260706.1",
    "typescript": "^5.7.2",
    "wrangler": "^4.105.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260722.1": true
  }
}
