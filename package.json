{
  "name": "risk-control-app",
  "version": "0.1.0",
  "description": "risk-control - plan de prevention et DUER (CBRE HSE)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply risk-control-db --local",
